{"nodes": [{"id": "_claude_skills_graphify_references_query_query_expansion", "label": "Constrained Query Expansion", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query CLI matches via case-folded substring + IDF with no stemming or synonyms, so vocabulary mismatch collapses answers to noise; expansion picks tokens only from the graph's own vocabulary and never invents tokens, keeping the expansion auditable."}, {"id": "_claude_skills_graphify_references_query_bfs_traversal", "label": "BFS Traversal", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Traversal modes table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default mode for broad context - nearest neighbors first, depth 3."}, {"id": "_claude_skills_graphify_references_query_dfs_traversal", "label": "DFS Traversal", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Traversal modes table", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For tracing a specific chain or dependency path; depth-limited to 6 to avoid traversing the whole graph."}, {"id": "_claude_skills_graphify_references_query_shortest_path", "label": "Shortest Path Query (/graphify path)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "For /graphify path", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_explain_node", "label": "Explain Node (/graphify explain)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "For /graphify explain", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_save_result", "label": "Save-Result Feedback Loop", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "save-result section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers are saved back into the graph so the next --update extracts the Q&A as a node, closing the feedback loop and improving future queries."}, {"id": "_claude_skills_graphify_references_query_work_memory", "label": "Work Memory Lessons (graphify reflect)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Work memory section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outcomes (useful/dead_end/corrected) feed LESSONS.md listing preferred sources, known dead ends, and corrections so future sessions learn from this one; --if-stale keeps session-start refresh nearly free."}], "edges": [{"source": "_claude_skills_graphify_references_query_query_expansion", "target": "_claude_skills_graphify_references_query_bfs_traversal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 0 'REQUIRED before traversal'", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_query_expansion", "target": "_claude_skills_graphify_references_query_dfs_traversal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 0 'REQUIRED before traversal'", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_bfs_traversal", "target": "_claude_skills_graphify_references_query_dfs_traversal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/