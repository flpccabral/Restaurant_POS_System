{"nodes": [{"id": "_claude_skills_graphify_skill_graphify", "label": "graphify Skill Pipeline", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "SKILL.md", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_knowledge_graph", "label": "Knowledge Graph", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "SKILL.md intro", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_ast_extraction", "label": "AST Structural Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic and free: code is extracted structurally with no LLM and no API key, so a code-only corpus needs no semantic pass at all."}, {"id": "_claude_skills_graphify_skill_semantic_extraction", "label": "Semantic Extraction (Parallel Subagents)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subagents are mandatory because reading files one-by-one is 5-10x slower; all chunks dispatch in a single message to run in parallel."}, {"id": "_claude_skills_graphify_skill_extraction_cache", "label": "Semantic Extraction Cache", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step B0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only uncached files go to subagents, saving tokens on re-runs; stale cache files are deleted so Part C never merges leftovers (#1392)."}, {"id": "_claude_skills_graphify_skill_community_detection", "label": "Community Detection", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surfaces cross-document connections the user would not think to ask about."}, {"id": "_claude_skills_graphify_skill_god_nodes", "label": "God Nodes", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4 analysis", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graph_health_check", "label": "Graph Health Check", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only integrity gate that surfaces edge collapse, dangling endpoints, and self-loops - the silent-corruption modes of incremental updates and AST/LLM id mismatches. Never aborts; warnings must be surfaced per the Honesty Rules."}, {"id": "_claude_skills_graphify_skill_shrink_guard", "label": "Shrink Guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4 export", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to write when the new graph is smaller than the existing graph.json, so an empty or partial extraction never clobbers a good graph, report, or analysis sidecar."}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Honesty Rules section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge; use AMBIGUOUS when unsure; always show token cost and raw cohesion scores; warn before visualizing graphs over 5000 nodes."}, {"id": "_claude_skills_graphify_skill_fast_path", "label": "Fast Path Query", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "What You Must Do When Invoked", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When graphify-out/graph.json already exists and the request is a natural-language question, skip the whole build pipeline and run graphify query immediately - the graph is already built."}, {"id": "_claude_skills_graphify_skill_gemini_backend", "label": "Gemini Extraction Backend", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 preamble", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify needs no API key; Gemini is used only if GEMINI_API_KEY/GOOGLE_API_KEY is already set, otherwise the host agent itself is the LLM. Never prompt for a key."}, {"id": "_claude_skills_graphify_skill_cost_tracker", "label": "Cumulative Cost Tracker", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graph_report", "label": "GRAPH_REPORT.md Audit Report", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Steps 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_html_visualization", "label": "Interactive HTML Graph", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-aggregates to community view if the graph exceeds 5000 nodes."}], "edges": [{"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_skill_knowledge_graph", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1