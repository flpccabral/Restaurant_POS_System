{"nodes": [{"id": "_agents_skills_pos_contrato_de_arquitetura_skill_pos_contrato_de_arquitetura", "label": "Skill: pos-contrato-de-arquitetura", "file_type": "document", "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_pos_contrato_de_arquitetura_skill_inv_1_store_isolation", "label": "INV-1: storeIsolation Middleware (Multi-Tenancy)", "file_type": "rationale", "rationale": "Multi-tenancy is enforced by middleware injecting req.storeId/req.store instead of separate databases; every store-scoped controller query must use req.storeId, never req.user.store directly. Master Admin may override via ?storeId=<uuid> after UUID validation.", "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": "INV-1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_pos_contrato_de_arquitetura_skill_inv_2_transacoes_estoque", "label": "INV-2: Atomic Stock Operations (MongoDB Transactions)", "file_type": "rationale", "rationale": "Any stock deduction/transfer/reversal/adjustment uses mongoose.startSession()+startTransaction(); the session is created in the controller and passed to the service to allow composition. Without atomicity, stock balances become inconsistent and COGS/financial data wrong (ADR-0002).", "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": "INV-2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_pos_contrato_de_arquitetura_skill_inv_3_jwt_cookie_httponly", "label": "INV-3: JWT in httpOnly Cookie", "file_type": "rationale", "rationale": "JWT lives in an httpOnly cookie (not localStorage) for XSS protection; token expiresIn 1d while cookie persists 30d (refresh endpoint not implemented). tokenVerification.js also accepts Authorization: Bearer for mobile/PDV clients.", "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": "INV-3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_pos_contrato_de_arquitetura_skill_inv_4_roles_dinamicas_rbac", "label": "INV-4: Dynamic RBAC Roles per Module", "file_type": "rationale", "rationale": "Roles are dynamic documents with per-module CRUD permission flags plus customPermissions, not hardcoded strings. userModel.role is Mixed (ObjectId or legacy String) as a transitional state until migration P2-01 normalizes all to ObjectId.", "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": "INV-4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_pos_contrato_de_arquitetura_skill_inv_5_auditoria_fire_and_forget", "label": "INV-5: Fire-and-Forget Audit Logging", "file_type": "rationale", "rationale": "auditService.logAudit catches all errors and returns null; in a running restaurant an audit failure must NEVER block a sale or stock transfer (ADR-0005).", "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": "INV-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_pos_contrato_de_arquitetura_skill_pos_contrato_de_arquitetura", "target": "_agents_skills_pos_controle_de_mudancas_skill_pos_controle_de_mudancas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_pos_contrato_de_arquitetura_skill_pos_contrato_de_arquitetura", "target": "_agents_skills_pos_seguranca_skill_pos_seguranca", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/pos-contrato-de-arquitetura/SKILL.md", "source_location": nul